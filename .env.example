# ==============================================================================
# ORBINOVA MAIN WEBSITE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# All public environment variables prefixed with NEXT_PUBLIC_ are embedded in client bundles.
# NEVER place secret API keys, private credentials, or database passwords in NEXT_PUBLIC_ variables.

# ------------------------------------------------------------------------------
# 1. External Module Integrations
# ------------------------------------------------------------------------------
# URLs provided by the independent Donor and Imaging teams.
# Donor module fallback to local route /login until hosted
NEXT_PUBLIC_DONOR_APP_URL=/login
# Imaging module deployed URL
NEXT_PUBLIC_IMAGING_APP_URL=https://smart-donor-imaging.vercel.app/login

# ------------------------------------------------------------------------------
# 2. Main Website Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://www.orbinova.com

# ------------------------------------------------------------------------------
# 3. Main Website Backend (If Applicable)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
